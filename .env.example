POSTGRES_PASSWORD=replace-with-generated-secret
DATABASE_URL=postgres://scorebook:replace-with-generated-secret@127.0.0.1:55432/scorebook
SCOREBOOK_STORAGE=./data
SCOREBOOK_BIND=127.0.0.1:8787
# Optional local DINOv2 process; unset = visual/hybrid requests fail explicitly
# SCOREBOOK_VISION_URL=http://127.0.0.1:8790

# Exact frontend origin; prefer a same-origin local BFF.
# SCOREBOOK_ALLOWED_ORIGIN=http://localhost:5173
# All workers sharing one outbound IP must use the same identifier.
SCOREBOOK_EGRESS_ID=local-default
SCOREBOOK_BINANCE_WEIGHT_PER_MINUTE=600

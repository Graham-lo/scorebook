POSTGRES_PASSWORD=replace-with-generated-secret
DATABASE_URL=postgres://scorebook:replace-with-generated-secret@127.0.0.1:55432/scorebook
SCOREBOOK_STORAGE=./data
SCOREBOOK_BIND=127.0.0.1:8787
# Optional local DINOv2 process; unset = visual/hybrid requests fail explicitly
# SCOREBOOK_VISION_URL=http://127.0.0.1:8790

# Exact frontend origin; prefer a same-origin local BFF.
# SCOREBOOK_ALLOWED_ORIGIN=http://localhost:5173
# All workers sharing one outbound IP must use the same identifier.
SCOREBOOK_EGRESS_ID=local-default
SCOREBOOK_BINANCE_WEIGHT_PER_MINUTE=600

# v4 optional local processes; missing components have explicit capability states.
# SCOREBOOK_TEXT_ENCODER_URL=http://127.0.0.1:8791
# SCOREBOOK_OCR_EXECUTABLE=/absolute/path/to/scorebook-ocr
# SCOREBOOK_RESTIC_EXECUTABLE=/absolute/path/to/ops/bin/restic
# Historical account export requires an explicitly sized weight budget >= 1000.
# Keep the default 600 until that workload is enabled intentionally.
# SCOREBOOK_ACCOUNT_EXPORT_HOSTS=explicit.exchange.download.host
# Exchange/backup secrets use owner-scoped macOS Keychain references, never this file.
# Chat provider has not been selected; do not add a guessed API key or model.
